# ===================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN JWT VỚI NIMBUS (TUẦN 10)
# Sao chép file này thành .env và cập nhật thông tin tương ứng máy bạn
# ===================================================================

# Cổng khởi chạy ứng dụng
SERVER_PORT=8005

# Kết nối cơ sở dữ liệu MySQL
DB_URL=jdbc:mysql://localhost:3306/tuan10_jwt_nimbus?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=root

# Khóa bí mật ký JWT HMAC-SHA256 (tối thiểu 32 bytes / 256 bits, mã hóa Base64)
# Mẫu dưới đây là khóa Base64 hợp lệ dùng cho môi trường thử nghiệm
JWT_SECRET=4q82vUQp3bXZ3Z4f2lO9kX7jM5qW1rT8yU6iO4pA2sD=

# Thời gian hết hạn của JWT (tính bằng milliseconds, ví dụ: 3600000 ms = 1 giờ)
JWT_EXPIRATION=3600000
